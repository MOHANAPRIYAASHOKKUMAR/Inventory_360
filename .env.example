# Copy to .env for local Docker runs:  docker run --env-file .env ...
# .env is git- and docker-ignored. Never commit real values.

# --- Snowflake identity (local Docker only; SPCS injects its own credentials) ---
SNOWFLAKE_ACCOUNT=TBSLJYV-RM91730
SNOWFLAKE_USER=MohanaAshok
# Read-only by default; use INV360_PLANNER only when testing replenishment submit
SNOWFLAKE_ROLE=INV360_VIEWER

# Option A: programmatic access token (Snowsight > Settings > Authentication) or password
SNOWFLAKE_PASSWORD=

# Option B: key-pair auth - mount the key and point to it (leave SNOWFLAKE_PASSWORD empty)
# SNOWFLAKE_PRIVATE_KEY_FILE=/secrets/rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_FILE_PWD=

# --- Application configuration ---
INV360_DATABASE=INVENTORY_360_DB
INV360_WAREHOUSE=INV360_WH
INV360_SCHEMA=MARTS
PORT=8501
